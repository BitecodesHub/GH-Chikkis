# Copy to .env.local and fill in. Never commit real values.
# Public site URL used for OAuth callbacks, canonical URLs and links.
APP_URL=http://localhost:3000

# MongoDB Atlas in production; a local mongod in development.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=ghchikkis

# Google OAuth (Web application). Authorised redirect URI:
# ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The Owner's Google account. It is bootstrapped as Owner on first sign-in.
OWNER_EMAIL=

# Development-only sign-in for seeded accounts. Always ignored in production.
DEV_AUTH_ENABLED=true

# Cloudinary (product media). Leave blank to use local uploads in development.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Meta WhatsApp Cloud API. Leave blank to run in simulation mode.
WHATSAPP_MODE=simulate
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0

# Gmail API manual sending. Leave blank to run in simulation mode.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=

# Backups. Required in production. Generate with: openssl rand -base64 32
BACKUP_ENCRYPTION_KEY=
BACKUP_PROVIDER=local
BACKUP_LOCAL_DIR=.backups

# Cron/queue protection. Required in production.
CRON_SECRET=

# Optional Cloudflare Turnstile for the public enquiry form.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional Google Analytics 4 measurement ID (loaded only after consent).
NEXT_PUBLIC_GA_ID=
